{{define "ublock"}}{{if eq .Kind "head"}}<p class="ph">{{range .Segs}}{{if .Nowrap}}<span class="nw">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</p>{{else if eq .Kind "para"}}<p>{{range .Segs}}{{if .Nowrap}}<span class="nw">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</p>{{else if eq .Kind "list"}}<ul class="deals-list">{{range .Items}}<li>{{range .Segs}}{{if .Nowrap}}<span class="nw">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</li>{{end}}</ul>{{end}}{{end}}
{{define "ulangscript"}}<script>
(function(){var KEY="pb-lang";function setLang(l){if(l!=="tl"&&l!=="en"&&l!=="ja")l="tl";try{localStorage.setItem(KEY,l);}catch(e){}document.documentElement.lang=l==="tl"?"fil":l;var els=document.querySelectorAll("[data-lang]");for(var i=0;i<els.length;i++){els[i].style.display=els[i].getAttribute("data-lang")===l?"":"none";}var btns=document.querySelectorAll("[data-setlang]");for(var k=0;k<btns.length;k++){btns[k].setAttribute("aria-pressed",btns[k].getAttribute("data-setlang")===l?"true":"false");}}var init="tl";try{init=localStorage.getItem(KEY)||"tl";}catch(e){}setLang(init);var btns=document.querySelectorAll("[data-setlang]");for(var k=0;k<btns.length;k++){(function(b){b.addEventListener("click",function(){setLang(b.getAttribute("data-setlang"));});})(btns[k]);}})();
</script>{{end}}
