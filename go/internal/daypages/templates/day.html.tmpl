{{define "day"}}<!doctype html>
<html lang="fil">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<link rel="canonical" href="{{.Canonical}}">
<link rel="icon" type="image/png" sizes="32x32" href="../../favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="../../favicon-16.png">
<link rel="apple-touch-icon" href="../../apple-touch-icon.png">
<meta name="theme-color" content="#0b5d3b">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Presyo Bantay">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Description}}">
<meta property="og:url" content="{{.Canonical}}">
{{if .OGImage}}<meta property="og:image" content="{{.OGImage}}">
<meta property="og:image:width" content="1080">
<meta property="og:image:height" content="1350">
<meta property="og:image:alt" content="{{.OGAlt}}">
{{end}}<meta property="og:locale" content="fil_PH">
<meta property="og:locale:alternate" content="en_US">
<meta property="og:locale:alternate" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{.Title}}">
<meta name="twitter:description" content="{{.Description}}">
{{if .OGImage}}<meta name="twitter:image" content="{{.OGImage}}">
{{end}}<meta property="article:published_time" content="{{.Published}}">
<script async src="https://www.googletagmanager.com/gtag/js?id=G-VL047YCMK8"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-VL047YCMK8');</script>
<style>
:root{--bg:#faf8f2;--card:#fff;--ink:#1c1a15;--muted:#5c5648;--line:#e2dccb;--accent:#0b5d3b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.5;font-size:16px}
.wrap{max-width:880px;margin:0 auto;padding:0 12px}
.site-header{background:var(--accent);color:#fff;padding:16px 0 14px}
.brand{display:flex;align-items:center;gap:12px;margin:0 0 10px;color:#fff;text-decoration:none}
a.brand:focus-visible{outline:3px solid #fff;outline-offset:3px;border-radius:10px}
.brand-mark{display:block;width:48px;height:48px;flex:none;border-radius:50%;background:#fdf6e3;box-shadow:0 0 0 2px rgba(244,197,66,.85)}
.brand-text{display:flex;flex-direction:column;line-height:1.25;min-width:0}
.brand-name{font-weight:800;letter-spacing:-0.02em;font-size:1.7rem;line-height:1.15;white-space:nowrap}
.brand-name .gold{color:#f4c542}
.tagline{margin:2px 0 0;font-size:.92rem;font-weight:400;letter-spacing:normal;color:rgba(255,255,255,.88)}
@media(max-width:519px){.brand-name{font-size:1.4rem}.brand-mark{width:40px;height:40px}}
.lang-toggle{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:0;font-size:.9rem}
.lang-toggle button{border:1px solid currentColor;background:transparent;color:inherit;border-radius:999px;padding:4px 12px;font:inherit;cursor:pointer;white-space:nowrap}
.lang-toggle button[aria-pressed="true"]{background:#fff;color:var(--accent);font-weight:700}
@media(max-width:519px){.lang-toggle .lang-label{display:none}}
main.wrap{padding-top:12px;padding-bottom:24px;display:grid;gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}
.hint{margin:0 0 8px;color:var(--muted);font-size:.88rem}
.pagenav{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.pagenav a{color:var(--accent)}
.region img{max-width:100%;height:auto;display:block;margin:8px auto}
@media(min-width:700px){.region img{max-width:540px}}
.ph{font-weight:700;margin:8px 0 4px}
.deals-list{margin:4px 0;padding-left:1.4em}
.nw{white-space:nowrap}
.site-footer{border-top:1px solid var(--line);padding:16px 0 24px;color:var(--muted);font-size:.9rem}
.site-footer a{color:var(--accent)}
</style>
</head>
<body>
<header class="site-header"><div class="wrap">
<a class="brand home" href="../../"><picture><source type="image/webp" srcset="../../brand/logo-mark-96.webp 2x, ../../brand/logo-mark-144.webp 3x"><img class="brand-mark" src="../../brand/logo-mark-96.png" srcset="../../brand/logo-mark-96.png 2x, ../../brand/logo-mark-144.png 3x" width="48" height="48" alt="" aria-hidden="true" fetchpriority="high" decoding="async"></picture><span class="brand-text"><span class="brand-name">Presyo <span class="gold">Bantay</span></span><span class="tagline"><span data-lang="tl">Araw-araw na presyo sa palengke, mula sa DA</span><span data-lang="en">Daily market prices from DA Bantay Presyo</span><span data-lang="ja">DAの市場価格を毎日お届け</span></span></span></a>
<div class="lang-toggle" role="group" aria-label="Wika / Language / 言語"><span class="lang-label">Taglish / English / 日本語:</span>
<button type="button" data-setlang="tl">Taglish</button>
<button type="button" data-setlang="en">English</button>
<button type="button" data-setlang="ja">日本語</button>
</div>
</div></header>
<main class="wrap">
<div>
<h1><span data-lang="tl">{{.DateTL}}</span><span data-lang="en">{{.DateEN}}</span><span data-lang="ja">{{.DateJA}}</span></h1>
<p><strong><span data-lang="tl">Sulit sa palengke</span><span data-lang="en">Market deals</span><span data-lang="ja">市場のお買い得</span></strong></p>
<p class="hint"><span data-lang="tl">% = kumpara sa usual na presyo (30 araw)</span><span data-lang="en">% = vs usual price (30-day)</span><span data-lang="ja">% = 30日間のいつもの価格比</span></p>
</div>
<nav class="pagenav card" aria-label="day navigation">
<span>{{if .HasOlder}}<a href="{{.OlderPath}}">&larr; <span data-lang="tl">{{.OlderTL}}</span><span data-lang="en">{{.OlderEN}}</span><span data-lang="ja">{{.OlderJA}}</span></a>{{end}}</span>
<span>{{if .HasNewer}}<a href="{{.NewerPath}}"><span data-lang="tl">{{.NewerTL}}</span><span data-lang="en">{{.NewerEN}}</span><span data-lang="ja">{{.NewerJA}}</span> &rarr;</a>{{end}}</span>
</nav>
{{if .Digest}}<section class="card region digest" aria-label="Metro Manila">
<h2><span data-lang="tl">Buod sa Metro Manila</span><span data-lang="en">Metro Manila summary</span><span data-lang="ja">メトロマニラ概況</span></h2>
<img src="{{.Digest.Image}}" width="1080" height="1350" alt="{{.Digest.AltTL}}" data-alt-en="{{.Digest.AltEN}}" data-alt-ja="{{.Digest.AltJA}}" fetchpriority="high">
<div data-lang="tl">{{range .Digest.BlocksTL}}{{template "block" .}}{{end}}</div>
<div data-lang="en">{{range .Digest.BlocksEN}}{{template "block" .}}{{end}}</div>
<div data-lang="ja">{{range .Digest.BlocksJA}}{{template "block" .}}{{end}}</div>
</section>
{{end}}{{range .Regions}}<section class="card region" aria-label="{{.TitleTL}}">
<h2><span data-lang="tl">{{.TitleTL}}</span><span data-lang="en">{{.TitleEN}}</span><span data-lang="ja">{{.TitleJA}}</span></h2>
{{if .HasData}}<img src="{{.Image}}" width="1080" height="1350" alt="{{.AltTL}}" data-alt-en="{{.AltEN}}" data-alt-ja="{{.AltJA}}"{{if .Eager}} fetchpriority="high"{{else}} loading="lazy" decoding="async"{{end}}>
<div data-lang="tl">{{range .BlocksTL}}{{template "block" .}}{{end}}</div>
<div data-lang="en">{{range .BlocksEN}}{{template "block" .}}{{end}}</div>
<div data-lang="ja">{{range .BlocksJA}}{{template "block" .}}{{end}}</div>
{{else}}<p class="hint"><span data-lang="tl">{{.NoDataTL}}</span><span data-lang="en">{{.NoDataEN}}</span><span data-lang="ja">{{.NoDataJA}}</span></p>
{{end}}</section>
{{end}}
<nav class="pagenav card" aria-label="day navigation">
<span>{{if .HasOlder}}<a href="{{.OlderPath}}">&larr; <span data-lang="tl">{{.OlderTL}}</span><span data-lang="en">{{.OlderEN}}</span><span data-lang="ja">{{.OlderJA}}</span></a>{{end}}</span>
<span>{{if .HasNewer}}<a href="{{.NewerPath}}"><span data-lang="tl">{{.NewerTL}}</span><span data-lang="en">{{.NewerEN}}</span><span data-lang="ja">{{.NewerJA}}</span> &rarr;</a>{{end}}</span>
</nav>
</main>
<footer class="site-footer"><div class="wrap">
<p>Source: <a href="https://www.da.gov.ph/price-monitoring/">DA Price Monitoring (Bantay Presyo)</a></p>
<p><span data-lang="tl">Hindi opisyal na DA page</span><span data-lang="en">Not an official DA page</span><span data-lang="ja">農業省の公式ページではありません</span></p>
<p><span data-lang="tl">Gumagamit ang site na ito ng Google Analytics para sa bilang ng bisita.</span><span data-lang="en">This site uses Google Analytics to count visits.</span><span data-lang="ja">アクセス解析にGoogleアナリティクスを使っています。</span></p>
<p><a href="../"><span data-lang="tl">Lahat ng ulat</span><span data-lang="en">All reports</span><span data-lang="ja">すべてのレポート</span></a> · <a href="../../">Presyo Bantay</a></p>
<p><span data-lang="tl">{{.FooterTL}}</span><span data-lang="en">{{.FooterEN}}</span><span data-lang="ja">{{.FooterJA}}</span></p>
</div></footer>
<script>
(function(){var KEY="pb-lang";function setLang(l){if(l!=="tl"&&l!=="en"&&l!=="ja")l="tl";try{localStorage.setItem(KEY,l);}catch(e){}document.documentElement.lang=l==="tl"?"fil":l;var els=document.querySelectorAll("[data-lang]");for(var i=0;i<els.length;i++){els[i].style.display=els[i].getAttribute("data-lang")===l?"":"none";}var imgs=document.querySelectorAll("img[data-alt-en]");for(var j=0;j<imgs.length;j++){var im=imgs[j];if(l==="en")im.alt=im.getAttribute("data-alt-en");else if(l==="ja")im.alt=im.getAttribute("data-alt-ja");else im.alt=im.getAttribute("alt")||im.alt;}var btns=document.querySelectorAll("[data-setlang]");for(var k=0;k<btns.length;k++){btns[k].setAttribute("aria-pressed",btns[k].getAttribute("data-setlang")===l?"true":"false");}}var init="tl";try{init=localStorage.getItem(KEY)||"tl";}catch(e){}setLang(init);var btns=document.querySelectorAll("[data-setlang]");for(var k=0;k<btns.length;k++){(function(b){b.addEventListener("click",function(){setLang(b.getAttribute("data-setlang"));});})(btns[k]);}})();
</script>
</body>
</html>
{{end}}
{{define "block"}}{{if eq .Kind "head"}}<p class="ph">{{range .Segs}}{{if .Nowrap}}<span class="nw">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</p>{{else if eq .Kind "para"}}<p>{{range .Segs}}{{if .Nowrap}}<span class="nw">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</p>{{else if eq .Kind "list"}}<ul class="deals-list">{{range .Items}}<li>{{range .Segs}}{{if .Nowrap}}<span class="nw">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}</li>{{end}}</ul>{{end}}{{end}}
