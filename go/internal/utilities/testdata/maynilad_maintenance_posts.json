[{"id": 19424, "date": "2026-10-23T17:32:45", "link": "https://www.mayniladwater.com.ph/maintenance-activities-for-the-upcoming-week-155/", "title": {"rendered": "Maintenance activities for the upcoming week"}, "content": {"rendered": "<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large is-resized\"><img fetchpriority=\"high\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"http://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-1024x683.jpg\" alt=\"\" class=\"wp-image-18644\" style=\"width:405px;height:auto\" srcset=\"https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-1024x683.jpg 1024w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-300x200.jpg 300w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-768x512.jpg 768w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-1536x1024.jpg 1536w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-2048x1365.jpg 2048w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /></figure></div>\n\n\n<p><br>Below are the scheduled maintenance activities of Maynilad next week, most of which will take place during off-peak hours to minimize the impact of the supply interruption on our customers.</p>\n\n\n\n<p>These activities are being done as part of the company’s continuous effort to improve water services in the West Zone.</p>\n\n\n\n<p>Affected customers are encouraged to store enough water for the duration of the water service interruption. Maynilad has water tankers on standby, ready to deliver water to affected areas as needed.</p>\n\n\n\n<p>Upon resumption of the water service, customers should let the water flow out for a few seconds until the water clears.<br></p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td>City</td><td>Barangay</td><td>Schedule</td><td>Activity</td><td>Location of Activity</td></tr><tr><td rowspan=\"2\">Caloocan</td><td>Brgy. 8, 25, 28, 32, 32 to 35, 166 and NBBS Kaunlaran</td><td>10:00 p.m. of October 26, 2026 to 6:00 a.m. of October 27, 2026</td><td>Several Maintenance Activities</td><td>Gen. Luis corner Torres, Dimasalang corner A. Mabini (North), Dagat-Dagatan Extension corner C3, A. Mabini (South) corner Dimasalang and Sinilyasi corner Salmon</td></tr><tr><td>Brgy. 49, 52 to 71, 73 to 75, 77 to 80, 93, 97, 98, 101 to 103, 105 to 107, 109 to 116, 121 to 131</td><td>11:00 p.m. of October 26, 2026 to 6:00 a.m. of October 27, 2026</td><td>Network Maintenance</td><td>7th Avenue corner D. Aquino</td></tr><tr><td>Quezon City</td><td>Brgy. 49, 52 to 71, 73 to 75, 77 to 80, 93, 97, 98, 101 to 103, 105 to 107, 109 to 116, 121 to 131</td><td>11:00 p.m. of October 26, 2026 to 6:00 a.m. of October 27, 2026</td><td>Network Maintenance</td><td>7th Avenue corner D. Aquino</td></tr></tbody></table></figure>\n", "protected": false}}, {"id": 19277, "date": "2026-08-21T16:47:11", "link": "https://www.mayniladwater.com.ph/maintenance-activities-for-the-upcoming-week-146/", "title": {"rendered": "Maintenance activities for the upcoming week"}, "content": {"rendered": "<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"http://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-1024x683.jpg\" alt=\"\" class=\"wp-image-18644\" style=\"width:432px;height:auto\" srcset=\"https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-1024x683.jpg 1024w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-300x200.jpg 300w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-768x512.jpg 768w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-1536x1024.jpg 1536w, https://www.mayniladwater.com.ph/wp-content/uploads/2026/03/20260123_3471-1-2048x1365.jpg 2048w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" /></figure></div>\n\n\n<p><br>Below are the scheduled maintenance activities of Maynilad next week, most of which will take place during off-peak hours to minimize the impact of the supply interruption on our customers.</p>\n\n\n\n<p>These activities are being done as part of the company’s continuous effort to improve water services in the West Zone.</p>\n\n\n\n<p>Affected customers are encouraged to store enough water for the duration of the water service interruption. Maynilad has water tankers on standby, ready to deliver water to affected areas as needed.</p>\n\n\n\n<p>Upon resumption of the water service, customers should let the water flow out for a few seconds until the water clears.<br></p>\n\n\n\n<figure class=\"wp-block-table\"><table class=\"has-fixed-layout\"><tbody><tr><td><strong>City</strong></td><td><strong>Barangay</strong></td><td><strong>Schedule</strong></td><td><strong>Activity</strong></td><td><strong>Location of Activity</strong></td></tr><tr><td>Caloocan</td><td>Brgy. 174</td><td>10:00 p.m. of August 25, 2026 to 6:00 a.m. of August 26, 2026</td><td>Network Diagnostic / Leak Localization</td><td>Pag-Asa Homesite</td></tr><tr><td>Las Piñas</td><td>Almanza Uno, Pilar, Talon Uno, Talon Dos and Talon Singko</td><td>10:00 p.m. of August 26, 2026 to 1:00 p.m. of August 27, 2026</td><td>Facility Maintenance</td><td>Marcos Alvarez Pumping Station and Magdiwang Pumping Station and Reservoir</td></tr><tr><td>Manila</td><td>Brgy. 821 to 828, 841 to 843 and 849 to 853</td><td>10:00 p.m. of August 24, 2026 to 4:00 a.m. of August 25, 2026</td><td>Network Maintenance</td><td>West Zamora Street</td></tr><tr><td>Parañaque</td><td>Don Bosco, Marcelo Green, San Antonio and San Isidro</td><td>1:00 p.m. to 7:00 p.m. of August 24, 2026</td><td>Network Diagnostic / Leak Localization</td><td>Marcelo corner Hemlock</td></tr><tr><td>Bacoor, Cavite</td><td>Molino II to Molino IV, Molino VII, Queens Row Central, Queens Row East, Queens Row West and San Nicholas III</td><td>10:00 p.m. of August 26, 2026 to 1:00 p.m. of August 27, 2026</td><td>Facility Maintenance</td><td>Marcos Alvarez Pumping Station and Magdiwang Pumping Station and Reservoir</td></tr><tr><td>Imus, Cavite</td><td>Pasong Buaya I and Pasong Buaya II</td><td>10:00 p.m. of August 26, 2026 to 1:00 p.m. of August 27, 2026</td><td>Facility Maintenance</td><td>Marcos Alvarez Pumping Station and Magdiwang Pumping Station and Reservoir</td></tr></tbody></table></figure>\n", "protected": false}}]